# Copy to .env (git-ignored). Never commit real values.
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/kroj
# Long random string; signs access, refresh and e-mail tokens.
SECRET=change-me
# Where the React app runs (links in e-mails, OAuth return).
FRONTEND_BASE_URL=http://localhost:5173
# Public base of this API when it is not on the frontend's origin (Google callback). Empty = same origin (Vite proxy / prod).
URL=
# Google sign-in (optional; without it the button reports "not available").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP (optional; without it e-mails are printed to the console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kroj <no-reply@example.com>"
